# Порт сервера
PORT=3000

# Строка подключения к PostgreSQL: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL=postgresql://notflex_user:your_password@localhost:5432/notflex

# Секрет подписи JWT (не короче 32 символов). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Срок жизни токена доступа
JWT_EXPIRES_IN=1h