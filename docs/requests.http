@baseUrl = http://localhost:3000/api

### Проверка сервера
GET {{baseUrl}}/health

### ===== АУТЕНТИФИКАЦИЯ =====

### Регистрация (поле role игнорируется, будет USER)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "name": "Студент",
  "password": "Pass1234",
  "role": "ADMIN"
}

### Регистрация: email уже занят -> 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user@notflex.local",
  "name": "Дубликат",
  "password": "Pass1234"
}

### Регистрация: неверные данные -> 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "name": "A",
  "password": "123"
}

### Вход как обычный пользователь
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@notflex.local",
  "password": "User1234!"
}

###
@userToken = {{loginUser.response.body.$.accessToken}}

### Вход как администратор
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@notflex.local",
  "password": "Admin123!"
}

###
@adminToken = {{loginAdmin.response.body.$.accessToken}}

### Вход: неверный пароль -> 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@notflex.local",
  "password": "wrong-password"
}

### ===== ПРОВЕРКА ПРАВ =====

### Профиль без токена -> 401
GET {{baseUrl}}/auth/me

### Профиль с токеном user -> 200
GET {{baseUrl}}/auth/me
Authorization: Bearer {{userToken}}

### Список пользователей: user -> 403
GET {{baseUrl}}/users
Authorization: Bearer {{userToken}}

### Список пользователей: admin -> 200
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

### ===== ТАЙТЛЫ: ЧТЕНИЕ (доступно всем) =====

### Список тайтлов (по умолчанию: страница 1, 10 штук)
GET {{baseUrl}}/titles

### Пагинация: страница 2, по 4 штуки
GET {{baseUrl}}/titles?page=2&limit=4

### Фильтр: только сериалы
GET {{baseUrl}}/titles?type=SERIES

### Фильтр по жанру (1 = Драма), сортировка по названию, по убыванию
GET {{baseUrl}}/titles?genreId=1&sort=name&order=desc

### Фильтр по режиссёру (2 = Кристофер Нолан)
GET {{baseUrl}}/titles?directorId=2

### Фильтр по году выпуска
GET {{baseUrl}}/titles?year=1994

### Поиск по названию (Шер -> Шерлок)
GET {{baseUrl}}/titles?search=%D0%A8%D0%B5%D1%80

### Неверные параметры -> 400
GET {{baseUrl}}/titles?limit=500&type=BOOK&page=0

### Один тайтл с режиссёром, жанрами и средней оценкой (Prisma include)
GET {{baseUrl}}/titles/2

### Тайтл не найден -> 404
GET {{baseUrl}}/titles/9999

### Неверный id -> 400
GET {{baseUrl}}/titles/abc

### ===== ТАЙТЛЫ: ИЗМЕНЕНИЕ (только admin) =====

### Создание без токена -> 401
POST {{baseUrl}}/titles
Content-Type: application/json

{
  "name": "Дюна",
  "type": "MOVIE",
  "releaseYear": 2021
}

### Создание с токеном user -> 403
POST {{baseUrl}}/titles
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Дюна",
  "type": "MOVIE",
  "releaseYear": 2021
}

### Создание с токеном admin -> 201
# @name createTitle
POST {{baseUrl}}/titles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Дюна",
  "type": "MOVIE",
  "releaseYear": 2021,
  "durationMin": 155,
  "description": "Наследник дома Атрейдес отправляется на пустынную планету Арракис.",
  "directorId": 2,
  "genreIds": [3, 6]
}

###
@newTitleId = {{createTitle.response.body.$.data.id}}

### Создание: неверные данные -> 400
POST {{baseUrl}}/titles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "type": "BOOK",
  "releaseYear": "abc"
}

### Создание: у фильма не может быть сезонов -> 400
POST {{baseUrl}}/titles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ошибка",
  "type": "MOVIE",
  "releaseYear": 2020,
  "seasons": 3
}

### Создание: несуществующий режиссёр -> 400
POST {{baseUrl}}/titles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ошибка",
  "type": "MOVIE",
  "releaseYear": 2020,
  "directorId": 999
}

### Изменение с токеном admin -> 200
PATCH {{baseUrl}}/titles/{{newTitleId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Дюна: Часть первая",
  "genreIds": [3]
}

### Изменение: пустое тело -> 400
PATCH {{baseUrl}}/titles/{{newTitleId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

### Изменение с токеном user -> 403
PATCH {{baseUrl}}/titles/{{newTitleId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Взлом"
}

### Изменение несуществующего -> 404
PATCH {{baseUrl}}/titles/9999
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Нет такого"
}

### Удаление с токеном user -> 403
DELETE {{baseUrl}}/titles/{{newTitleId}}
Authorization: Bearer {{userToken}}

### Удаление с токеном admin -> 200
DELETE {{baseUrl}}/titles/{{newTitleId}}
Authorization: Bearer {{adminToken}}

### Повторное удаление -> 404
DELETE {{baseUrl}}/titles/{{newTitleId}}
Authorization: Bearer {{adminToken}}

### ===== ЖАНРЫ =====

### Список жанров (с количеством тайтлов)
GET {{baseUrl}}/genres

### Жанр со списком его тайтлов (3 = Фантастика)
GET {{baseUrl}}/genres/3

### Создание жанра: user -> 403
POST {{baseUrl}}/genres
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Мюзикл"
}

### Создание жанра: admin -> 201
# @name createGenre
POST {{baseUrl}}/genres
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Мюзикл"
}

###
@newGenreId = {{createGenre.response.body.$.data.id}}

### Создание жанра: такое название уже есть -> 409
POST {{baseUrl}}/genres
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Мюзикл"
}

### Изменение жанра: admin -> 200
PATCH {{baseUrl}}/genres/{{newGenreId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Мюзикл и музыка"
}

### Удаление жанра: admin -> 200
DELETE {{baseUrl}}/genres/{{newGenreId}}
Authorization: Bearer {{adminToken}}

### ===== РЕЖИССЁРЫ =====

### Список режиссёров (с количеством тайтлов)
GET {{baseUrl}}/directors

### Режиссёр со списком его тайтлов (2 = Кристофер Нолан)
GET {{baseUrl}}/directors/2

### Режиссёр не найден -> 404
GET {{baseUrl}}/directors/999

### Создание режиссёра: user -> 403
POST {{baseUrl}}/directors
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "Дени Вильнёв"
}

### Создание режиссёра: admin -> 201
# @name createDirector
POST {{baseUrl}}/directors
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Дени Вильнёв"
}

###
@newDirectorId = {{createDirector.response.body.$.data.id}}

### Изменение режиссёра: admin -> 200
PATCH {{baseUrl}}/directors/{{newDirectorId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Дени Вильнёв (реж.)"
}

### Удаление режиссёра: admin -> 200
DELETE {{baseUrl}}/directors/{{newDirectorId}}
Authorization: Bearer {{adminToken}}

### ===== ОЦЕНКИ =====

### Оценки тайтла (с именами авторов)
GET {{baseUrl}}/titles/1/ratings

### Оценки тайтла: пагинация
GET {{baseUrl}}/titles/1/ratings?limit=1&page=2

### Оценки несуществующего тайтла -> 404
GET {{baseUrl}}/titles/9999/ratings

### Поставить оценку без токена -> 401
POST {{baseUrl}}/titles/3/ratings
Content-Type: application/json

{
  "value": 8
}

### Поставить оценку: значение вне диапазона -> 400
POST {{baseUrl}}/titles/3/ratings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "value": 11
}

### Поставить оценку несуществующему тайтлу -> 404
POST {{baseUrl}}/titles/9999/ratings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "value": 8
}

### Поставить оценку: user -> 201
### (userId и titleId в теле игнорируются, автор берётся из токена)
# @name createRating
POST {{baseUrl}}/titles/3/ratings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "value": 9,
  "comment": "Космос!",
  "userId": 1,
  "titleId": 5
}

###
@newRatingId = {{createRating.response.body.$.data.id}}

### Повторная оценка того же тайтла -> 409
POST {{baseUrl}}/titles/3/ratings
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "value": 5
}

### Мои оценки вместе с тайтлами -> 200
GET {{baseUrl}}/ratings/my
Authorization: Bearer {{userToken}}

### Мои оценки без токена -> 401
GET {{baseUrl}}/ratings/my

### Изменить свою оценку -> 200
PATCH {{baseUrl}}/ratings/{{createRating.response.body.$.data.id}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "value": 10
}

### Изменить пустым телом -> 400
PATCH {{baseUrl}}/ratings/{{createRating.response.body.$.data.id}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{}

### Изменить ЧУЖУЮ оценку (admin правит оценку user) -> 403
PATCH {{baseUrl}}/ratings/{{createRating.response.body.$.data.id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "value": 1
}

### Удалить ЧУЖУЮ оценку (user удаляет оценку admin, id 4) -> 403
DELETE {{baseUrl}}/ratings/4
Authorization: Bearer {{userToken}}

### Тайтл со средней оценкой
GET {{baseUrl}}/titles/3

### Удалить оценку: admin может удалить любую -> 200
DELETE {{baseUrl}}/ratings/{{createRating.response.body.$.data.id}}
Authorization: Bearer {{adminToken}}

### Повторное удаление -> 404
DELETE {{baseUrl}}/ratings/{{createRating.response.body.$.data.id}}
Authorization: Bearer {{adminToken}}

### ===== РОЛИ ПОЛЬЗОВАТЕЛЕЙ (только admin) =====

###
@userId = {{loginUser.response.body.$.user.id}}

### Смена роли: user пытается назначить роль -> 403
PATCH {{baseUrl}}/users/{{userId}}/role
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "role": "ADMIN"
}

### Смена роли: неверное значение -> 400
PATCH {{baseUrl}}/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "SUPER"
}

### Смена роли: администратор меняет собственную роль -> 400
PATCH {{baseUrl}}/users/1/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "USER"
}

### Смена роли: пользователь не найден -> 404
PATCH {{baseUrl}}/users/9999/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "USER"
}

### Назначить пользователя администратором -> 200
PATCH {{baseUrl}}/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "ADMIN"
}

### Тот же токен user теперь открывает список пользователей -> 200
### (роль берётся из базы, поэтому новый вход не нужен)
GET {{baseUrl}}/users
Authorization: Bearer {{userToken}}

### ОБЯЗАТЕЛЬНО вернуть роль USER обратно -> 200
PATCH {{baseUrl}}/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "USER"
}

### После возврата роли список пользователей снова закрыт -> 403
GET {{baseUrl}}/users
Authorization: Bearer {{userToken}}